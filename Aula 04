/*
 * Aula 04 - Estruturas Condicionais
 * Atividade 1: Classificar um nadador pela idade.
 *
 *  Infantil A: 5 a 7   | Infantil B: 8 a 10 | Juvenil A: 11 a 13
 *  Juvenil B: 14 a 17  | Senior: maiores de 17
 *
 * Saida: Nadador de idade <idade> eh da categoria <categoria>
 */
#include <stdio.h>

int main() {
    int idade;
    const char *categoria;

    printf("Digite a idade do nadador: ");
    scanf("%d", &idade);

    if (idade < 5) {
        printf("Nadador de idade %d nao possui categoria (idade minima: 5 anos).\n", idade);
        return 0;
    }

    if (idade <= 7) {
        categoria = "Infantil A";
    } else if (idade <= 10) {
        categoria = "Infantil B";
    } else if (idade <= 13) {
        categoria = "Juvenil A";
    } else if (idade <= 17) {
        categoria = "Juvenil B";
    } else {
        categoria = "Senior";
    }

    printf("Nadador de idade %d eh da categoria %s\n", idade, categoria);
    return 0;
}

/*
 * Atividade 2: Ler o mes (1 a 12) e escrever quantos dias ele tem.
 * Usar switch case. Considerar que fevereiro tem 28 dias.
 */
#include <stdio.h>

int main() {
    int mes;

    printf("Digite o mes (1 a 12): ");
    scanf("%d", &mes);

    switch (mes) {
        case 1:
        case 3:
        case 5:
        case 7:
        case 8:
        case 10:
        case 12:
            printf("O mes %d tem 31 dias.\n", mes);
            break;
        case 4:
        case 6:
        case 9:
        case 11:
            printf("O mes %d tem 30 dias.\n", mes);
            break;
        case 2:
            printf("O mes %d tem 28 dias.\n", mes);
            break;
        default:
            printf("Mes invalido! Digite um valor entre 1 e 12.\n");
    }

    return 0;
}

/*
 * Atividade 3: Sistema de classificacao de triangulos.
 *
 * Le tres lados inteiros e:
 *  - verifica se formam um triangulo;
 *  - classifica quanto aos lados: equilatero, isosceles ou escaleno;
 *  - classifica quanto aos angulos: acutangulo, retangulo ou obtusangulo.
 * Restricao: sem funcoes prontas de classificacao.
 *
 * Condicao de existencia: cada lado deve ser MENOR que a soma dos outros dois
 * (e todos positivos).
 * Angulos: seja c o maior lado ->
 *   c^2 == a^2 + b^2 : retangulo | c^2 < a^2 + b^2 : acutangulo | c^2 > a^2 + b^2 : obtusangulo
 */
#include <stdio.h>

int main() {
    long long a, b, c;
    long long maior, outro1, outro2;
    long long quadMaior, somaQuad;

    printf("Digite os tres lados do triangulo: ");
    scanf("%lld %lld %lld", &a, &b, &c);

    /* 1) Existe triangulo? */
    if (a <= 0 || b <= 0 || c <= 0 || a >= b + c || b >= a + c || c >= a + b) {
        printf("Os valores %lld, %lld e %lld NAO formam um triangulo.\n", a, b, c);
        return 0;
    }

    printf("Os valores formam um triangulo.\n");

    /* 2) Classificacao quanto aos lados */
    if (a == b && b == c) {
        printf("Quanto aos lados: equilatero\n");
    } else if (a == b || a == c || b == c) {
        printf("Quanto aos lados: isosceles\n");
    } else {
        printf("Quanto aos lados: escaleno\n");
    }

    /* 3) Descobre o maior lado (sem ordenar) */
    if (a >= b && a >= c) {
        maior = a; outro1 = b; outro2 = c;
    } else if (b >= a && b >= c) {
        maior = b; outro1 = a; outro2 = c;
    } else {
        maior = c; outro1 = a; outro2 = b;
    }

    quadMaior = maior * maior;
    somaQuad = outro1 * outro1 + outro2 * outro2;

    /* 4) Classificacao quanto aos angulos */
    if (quadMaior == somaQuad) {
        printf("Quanto aos angulos: retangulo\n");
    } else if (quadMaior < somaQuad) {
        printf("Quanto aos angulos: acutangulo\n");
    } else {
        printf("Quanto aos angulos: obtusangulo\n");
    }

    return 0;
}

/*
 * Atividade 4: Caixa eletronico.
 *
 * Cedulas: R$ 200, 100, 50, 20, 10 e 5.
 * O programa verifica: se o valor eh valido, se o saque eh possivel, quais
 * cedulas entregar, a quantidade de cada uma e o total de cedulas.
 * Regra adicional: o caixa deve PRESERVAR pelo menos uma cedula de cada
 * denominacao.
 *
 * Suposicoes (o enunciado nao informa o estoque do caixa):
 *  - o caixa comeca com ESTOQUE_INICIAL cedulas de cada denominacao;
 *  - portanto, de cada denominacao so podem ser entregues (ESTOQUE_INICIAL - 1);
 *  - o saque usa o metodo guloso (maiores cedulas primeiro), respeitando esse limite.
 *
 * Valor valido: maior que zero e multiplo de 5 (menor cedula).
 */
#include <stdio.h>

#define ESTOQUE_INICIAL 10

int main() {
    int valor, restante;
    int disponivel = ESTOQUE_INICIAL - 1; /* cedulas que podem sair de cada tipo */
    int n200, n100, n50, n20, n10, n5;
    int total;

    printf("Digite o valor do saque: R$ ");
    scanf("%d", &valor);

    /* 1) Valor valido? */
    if (valor <= 0 || valor % 5 != 0) {
        printf("Valor invalido! Digite um valor positivo e multiplo de 5.\n");
        return 0;
    }

    /* 2) Calcula as cedulas (guloso com limite por denominacao) */
    restante = valor;

    n200 = restante / 200; if (n200 > disponivel) n200 = disponivel; restante -= n200 * 200;
    n100 = restante / 100; if (n100 > disponivel) n100 = disponivel; restante -= n100 * 100;
    n50  = restante / 50;  if (n50  > disponivel) n50  = disponivel; restante -= n50  * 50;
    n20  = restante / 20;  if (n20  > disponivel) n20  = disponivel; restante -= n20  * 20;
    n10  = restante / 10;  if (n10  > disponivel) n10  = disponivel; restante -= n10  * 10;
    n5   = restante / 5;   if (n5   > disponivel) n5   = disponivel; restante -= n5   * 5;

    /* 3) Se sobrou valor, nao eh possivel sem violar a regra */
    if (restante != 0) {
        printf("Saque NAO realizado: nao eh possivel pagar R$ %d preservando "
               "pelo menos uma cedula de cada denominacao.\n", valor);
        return 0;
    }

    total = n200 + n100 + n50 + n20 + n10 + n5;

    printf("\nSaque de R$ %d realizado com sucesso!\n", valor);
    printf("Cedulas entregues:\n");
    if (n200 > 0) printf("  %d nota(s) de R$ 200\n", n200);
    if (n100 > 0) printf("  %d nota(s) de R$ 100\n", n100);
    if (n50  > 0) printf("  %d nota(s) de R$ 50\n",  n50);
    if (n20  > 0) printf("  %d nota(s) de R$ 20\n",  n20);
    if (n10  > 0) printf("  %d nota(s) de R$ 10\n",  n10);
    if (n5   > 0) printf("  %d nota(s) de R$ 5\n",   n5);
    printf("Total de cedulas: %d\n", total);

    return 0;
}

/*
 * Atividade 5: Ler tres inteiros A, B e C e informar (sem ordenar, sem
 * funcoes auxiliares, apenas comparacoes condicionais):
 *  maior, menor, intermediario, se ha repetidos, se os tres sao iguais,
 *  se estao em ordem crescente e se estao em ordem decrescente.
 *
 * Obs.: "crescente"/"decrescente" sao consideradas ESTRITAS (A<B<C / A>B>C).
 */
#include <stdio.h>

int main() {
    int A, B, C;
    int maior, menor, medio;

    printf("Digite tres numeros inteiros (A B C): ");
    scanf("%d %d %d", &A, &B, &C);

    /* Maior valor */
    if (A >= B && A >= C) {
        maior = A;
    } else if (B >= A && B >= C) {
        maior = B;
    } else {
        maior = C;
    }

    /* Menor valor */
    if (A <= B && A <= C) {
        menor = A;
    } else if (B <= A && B <= C) {
        menor = B;
    } else {
        menor = C;
    }

    /* Valor intermediario */
    if ((A >= B && A <= C) || (A <= B && A >= C)) {
        medio = A;
    } else if ((B >= A && B <= C) || (B <= A && B >= C)) {
        medio = B;
    } else {
        medio = C;
    }

    printf("Maior valor: %d\n", maior);
    printf("Menor valor: %d\n", menor);
    printf("Valor intermediario: %d\n", medio);

    /* Repetidos / iguais */
    if (A == B && B == C) {
        printf("Os tres valores sao iguais.\n");
        printf("Existem valores repetidos: sim\n");
    } else if (A == B || A == C || B == C) {
        printf("Os tres valores nao sao todos iguais.\n");
        printf("Existem valores repetidos: sim\n");
    } else {
        printf("Os tres valores nao sao todos iguais.\n");
        printf("Existem valores repetidos: nao\n");
    }

    /* Ordem */
    if (A < B && B < C) {
        printf("Os valores estao em ordem crescente.\n");
    } else {
        printf("Os valores NAO estao em ordem crescente.\n");
    }

    if (A > B && B > C) {
        printf("Os valores estao em ordem decrescente.\n");
    } else {
        printf("Os valores NAO estao em ordem decrescente.\n");
    }

    return 0;
}

/*
 * Atividade 6: Menu com switch.
 *
 * ===== MENU =====
 * 1 - Verificar numero par ou impar (e tambem positivo, negativo ou zero)
 * 2 - Verificar se eh positivo ou negativo
 * 3 - Calcular o quadrado do numero
 * 4 - Sair
 *
 * Opcoes invalidas sao tratadas no default. O menu se repete ate o usuario
 * escolher "Sair".
 */
#include <stdio.h>

int main() {
    int opcao, numero;

    do {
        printf("\n===== MENU =====\n");
        printf("1 - Verificar numero par ou impar\n");
        printf("2 - Verificar se e positivo ou negativo\n");
        printf("3 - Calcular o quadrado do numero\n");
        printf("4 - Sair\n");
        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);

        switch (opcao) {
            case 1:
                printf("Digite um numero: ");
                scanf("%d", &numero);
                if (numero % 2 == 0) {
                    printf("O numero %d eh par", numero);
                } else {
                    printf("O numero %d eh impar", numero);
                }
                if (numero > 0) {
                    printf(" e positivo.\n");
                } else if (numero < 0) {
                    printf(" e negativo.\n");
                } else {
                    printf(" e zero.\n");
                }
                break;

            case 2:
                printf("Digite um numero: ");
                scanf("%d", &numero);
                if (numero > 0) {
                    printf("O numero %d eh positivo.\n", numero);
                } else if (numero < 0) {
                    printf("O numero %d eh negativo.\n", numero);
                } else {
                    printf("O numero eh zero (nem positivo, nem negativo).\n");
                }
                break;

            case 3:
                printf("Digite um numero: ");
                scanf("%d", &numero);
                printf("O quadrado de %d eh %lld\n", numero, (long long)numero * numero);
                break;

            case 4:
                printf("Saindo...\n");
                break;

            default:
                printf("Opcao invalida! Escolha entre 1 e 4.\n");
        }
    } while (opcao != 4);

    return 0;
}
