/*
 * Aula 06 - Vetores e Matrizes
 * Exercicio de aula: Armazenar as notas (medias) de sete alunos em um vetor,
 * usando estrutura de repeticao para ler e para exibir.
 */
#include <stdio.h>

#define QTD 7

int main() {
    float medias[QTD];
    int i;

    for (i = 0; i < QTD; i++) {
        printf("Digite a media do aluno %d: ", i + 1);
        scanf("%f", &medias[i]);
    }

    printf("\nMedias armazenadas:\n");
    for (i = 0; i < QTD; i++) {
        printf("Aluno %d: %.2f\n", i + 1, medias[i]);
    }

    return 0;
}
* Atividade 1: Ler o nome e a media de um aluno e exibir os valores lidos.
 * O nome eh um vetor de char (string).
 */
#include <stdio.h>

int main() {
    char nome[50];
    float media;

    printf("Digite o nome do aluno: ");
    scanf(" %49[^\n]", nome);   /* le ate o Enter (aceita espacos) */

    printf("Digite a media do aluno: ");
    scanf("%f", &media);

    printf("\nNome: %s\n", nome);
    printf("Media: %.2f\n", media);

    return 0;
}
* Atividade 2: Ler o nome e a media de 30 alunos usando vetores e exibir a
 * lista com os nomes e as medias.
 *
 * nomes[30][50] -> vetor de 30 strings de ate 49 caracteres
 * medias[30]    -> vetor de 30 floats
 */
#include <stdio.h>

#define QTD 30

int main() {
    char nomes[QTD][50];
    float medias[QTD];
    int i;

    for (i = 0; i < QTD; i++) {
        printf("Aluno %d - nome: ", i + 1);
        scanf(" %49[^\n]", nomes[i]);
        printf("Aluno %d - media: ", i + 1);
        scanf("%f", &medias[i]);
    }

    printf("\n===== LISTA DE ALUNOS =====\n");
    for (i = 0; i < QTD; i++) {
        printf("%2d. %-30s %.2f\n", i + 1, nomes[i], medias[i]);
    }

    return 0;
}
* Atividade 3: Gerar uma matriz 3x3 de inteiros e exibi-la separando os
 * elementos da mesma linha por " - " e as linhas por nova linha.
 *
 * Exemplo de saida:
 * 300 - 5 - 3
 * 4 - 10 - 3
 * 12 - 337 - 5
 */
#include <stdio.h>

#define LINHAS 3
#define COLUNAS 3

int main() {
    int matriz[LINHAS][COLUNAS];
    int i, j;

    for (i = 0; i < LINHAS; i++) {
        for (j = 0; j < COLUNAS; j++) {
            printf("Digite o elemento [%d][%d]: ", i, j);
            scanf("%d", &matriz[i][j]);
        }
    }

    printf("\nMatriz:\n");
    for (i = 0; i < LINHAS; i++) {
        for (j = 0; j < COLUNAS; j++) {
            printf("%d", matriz[i][j]);
            if (j < COLUNAS - 1) {
                printf(" - ");
            }
        }
        printf("\n");
    }

    return 0;
}
* Atividade 4: Ler 3 notas de 3 alunos e calcular a media de cada aluno.
 * As notas ficam em uma matriz 2D: coluna 0 = nota1, coluna 1 = nota2,
 * coluna 2 = nota3 e coluna 3 = media. Em seguida, exibir a tabela.
 */
#include <stdio.h>

#define ALUNOS 3
#define NOTAS 3

int main() {
    float tabela[ALUNOS][NOTAS + 1];
    float soma;
    int i, j;

    for (i = 0; i < ALUNOS; i++) {
        soma = 0;
        for (j = 0; j < NOTAS; j++) {
            printf("Aluno %d - nota %d: ", i + 1, j + 1);
            scanf("%f", &tabela[i][j]);
            soma += tabela[i][j];
        }
        tabela[i][NOTAS] = soma / NOTAS;   /* ultima coluna = media */
    }

    printf("\n%-8s %7s %7s %7s %7s\n", "Aluno", "Nota1", "Nota2", "Nota3", "Media");
    for (i = 0; i < ALUNOS; i++) {
        printf("%-8d", i + 1);
        for (j = 0; j < NOTAS + 1; j++) {
            printf(" %7.2f", tabela[i][j]);
        }
        printf("\n");
    }

    return 0;
}
* Atividade 5: Ler 10 inteiros em um array e pedir um numero para pesquisar.
 * Informar: se foi encontrado, quantas vezes aparece e em quais posicoes
 * (indices, comecando em 0).
 *
 * Exemplo:
 * Array: 5 8 3 8 2 8 1 4 6 8
 * Digite um numero: 8
 * O numero 8 foi encontrado 4 vezes.
 * Posicoes: 1, 3, 5, 9
 */
#include <stdio.h>

#define TAM 10

int main() {
    int array[TAM];
    int procurado, i;
    int quantidade = 0;

    for (i = 0; i < TAM; i++) {
        printf("Digite o elemento %d: ", i + 1);
        scanf("%d", &array[i]);
    }

    printf("\nArray:");
    for (i = 0; i < TAM; i++) {
        printf(" %d", array[i]);
    }

    printf("\nDigite um numero para pesquisar: ");
    scanf("%d", &procurado);

    /* primeira passada: conta as ocorrencias */
    for (i = 0; i < TAM; i++) {
        if (array[i] == procurado) {
            quantidade++;
        }
    }

    if (quantidade == 0) {
        printf("O numero %d NAO foi encontrado no array.\n", procurado);
    } else {
        printf("O numero %d foi encontrado %d vez(es).\n", procurado, quantidade);
        printf("Posicoes: ");

        int impressos = 0;
        for (i = 0; i < TAM; i++) {
            if (array[i] == procurado) {
                if (impressos > 0) {
                    printf(", ");
                }
                printf("%d", i);
                impressos++;
            }
        }
        printf("\n");
    }

    return 0;
}
* Atividade 6: Uma loja possui 10 produtos. Armazenar em um array a
 * quantidade disponivel de cada produto e:
 *  - mostrar a quantidade de cada produto;
 *  - informar quais produtos estao com estoque baixo (quantidade < 5);
 *  - informar quais produtos estao esgotados (quantidade = 0);
 *  - contar quantos produtos possuem mais de 20 unidades;
 *  - informar qual produto possui a maior quantidade em estoque.
 */
#include <stdio.h>

#define PRODUTOS 10

int main() {
    int estoque[PRODUTOS];
    int i;
    int encontrou;
    int acimaDe20 = 0;
    int indiceMaior = 0;

    for (i = 0; i < PRODUTOS; i++) {
        do {
            printf("Quantidade em estoque do produto %d: ", i + 1);
            scanf("%d", &estoque[i]);
            if (estoque[i] < 0) {
                printf("  Quantidade invalida!\n");
            }
        } while (estoque[i] < 0);
    }

    printf("\n--- Quantidade de cada produto ---\n");
    for (i = 0; i < PRODUTOS; i++) {
        printf("Produto %2d: %d unidade(s)\n", i + 1, estoque[i]);
    }

    printf("\n--- Estoque baixo (menos de 5 unidades) ---\n");
    encontrou = 0;
    for (i = 0; i < PRODUTOS; i++) {
        if (estoque[i] < 5) {
            printf("Produto %d (%d unidade(s))\n", i + 1, estoque[i]);
            encontrou = 1;
        }
    }
    if (!encontrou) {
        printf("Nenhum produto com estoque baixo.\n");
    }

    printf("\n--- Produtos esgotados ---\n");
    encontrou = 0;
    for (i = 0; i < PRODUTOS; i++) {
        if (estoque[i] == 0) {
            printf("Produto %d\n", i + 1);
            encontrou = 1;
        }
    }
    if (!encontrou) {
        printf("Nenhum produto esgotado.\n");
    }

    for (i = 0; i < PRODUTOS; i++) {
        if (estoque[i] > 20) {
            acimaDe20++;
        }
        if (estoque[i] > estoque[indiceMaior]) {
            indiceMaior = i;
        }
    }

    printf("\nProdutos com mais de 20 unidades: %d\n", acimaDe20);
    printf("Produto com maior estoque: produto %d (%d unidades)\n",
           indiceMaior + 1, estoque[indiceMaior]);

    return 0;
}
