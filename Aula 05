
/*
 * Aula 02 - Estruturas de Repeticao
 * Pratica 1: Ler numeros digitados pelo usuario e exibir cada um na tela,
 * enquanto o valor digitado for diferente de 0. Ao digitar 0, exibir
 * "Programa encerrado."
 */
#include <stdio.h>

int main() {
    int numero;

    printf("Digite um numero (0 para sair): ");
    scanf("%d", &numero);

    while (numero != 0) {
        printf("Voce digitou: %d\n", numero);
        printf("Digite outro numero (0 para sair): ");
        scanf("%d", &numero);
    }

    printf("Programa encerrado.\n");
    return 0;
}
* Pratica 2: "Qual o objetivo desse algoritmo? Construa uma solucao mais elegante."
 *
 * Objetivo do algoritmo anterior: ler numeros e exibi-los ate que o usuario
 * digite 0 (valor sentinela).
 *
 * Problema da versao anterior: o printf/scanf de leitura aparece DUAS vezes
 * (antes do while e dentro dele). Com do...while, a leitura fica em um unico
 * lugar, pois o corpo executa pelo menos uma vez.
 */
#include <stdio.h>

int main() {
    int numero;

    do {
        printf("Digite um numero (0 para sair): ");
        scanf("%d", &numero);

        if (numero != 0) {
            printf("Voce digitou: %d\n", numero);
        }
    } while (numero != 0);

    printf("Programa encerrado.\n");
    return 0;
}
* Pratica 3: Simulacao de login com do...while.
 * Login correto -> usuario: admin | senha: 1234
 * Pede as credenciais enquanto estiverem incorretas (pelo menos uma vez).
 */
#include <stdio.h>
#include <string.h>

int main() {
    char usuario[20];
    char senha[20];
    int credenciaisCorretas;

    do {
        printf("Digite o usuario: ");
        scanf("%19s", usuario);
        printf("Digite a senha: ");
        scanf("%19s", senha);

        credenciaisCorretas = (strcmp(usuario, "admin") == 0 && strcmp(senha, "1234") == 0);

        if (!credenciaisCorretas) {
            printf("Usuario ou senha incorretos. Tente novamente.\n\n");
        }
    } while (!credenciaisCorretas);

    printf("\nLogin realizado com sucesso! Bem-vindo ao sistema.\n");
    return 0;
}
