* Lista - Questao 2: Ler as notas de varios alunos (enquanto o usuario
 * desejar). Para cada aluno, ler 3 notas, calcular a media e informar:
 *   Aprovado     : media >= 7
 *   Recuperacao  : 5 <= media < 7
 *   Reprovado    : media < 5
 * Ao final, informar quantos foram aprovados, em recuperacao e reprovados.
 */
#include <stdio.h>

int main() {
    float nota, soma, media;
    int aprovados = 0, recuperacao = 0, reprovados = 0;
    int aluno = 0;
    int i;
    char continuar;

    do {
        aluno++;
        soma = 0;
        printf("\n--- Aluno %d ---\n", aluno);

        for (i = 1; i <= 3; i++) {
            printf("Digite a nota %d: ", i);
            scanf("%f", &nota);
            soma += nota;
        }

        media = soma / 3;
        printf("Media: %.2f -> ", media);

        if (media >= 7) {
            printf("Aprovado\n");
            aprovados++;
        } else if (media >= 5) {
            printf("Recuperacao\n");
            recuperacao++;
        } else {
            printf("Reprovado\n");
            reprovados++;
        }

        printf("Deseja cadastrar outro aluno? (S/N): ");
        scanf(" %c", &continuar);
    } while (continuar == 'S' || continuar == 's');

    printf("\n===== RESUMO =====\n");
    printf("Aprovados: %d\n", aprovados);
    printf("Recuperacao: %d\n", recuperacao);
    printf("Reprovados: %d\n", reprovados);
    return 0;
}
* Lista - Questao 3: Ler 10 inteiros e determinar o maior, o menor e a
 * diferenca entre eles.
 * Restricao: NAO usar vetores ou matrizes.
 */
#include <stdio.h>

int main() {
    int numero, maior, menor;
    int i;

    printf("Digite o numero 1: ");
    scanf("%d", &numero);
    maior = numero;   /* o primeiro valor inicia maior e menor */
    menor = numero;

    for (i = 2; i <= 10; i++) {
        printf("Digite o numero %d: ", i);
        scanf("%d", &numero);

        if (numero > maior) {
            maior = numero;
        }
        if (numero < menor) {
            menor = numero;
        }
    }

    printf("\nMaior numero: %d\n", maior);
    printf("Menor numero: %d\n", menor);
    printf("Diferenca entre o maior e o menor: %d\n", maior - menor);
    return 0;
}
* Lista - Questao 4: Ler inteiros continuamente ate o usuario digitar 0.
 * Ao final apresentar: soma dos positivos, soma dos negativos, quantidade de
 * positivos e quantidade de negativos. O zero nao eh positivo nem negativo.
 */
#include <stdio.h>

int main() {
    int numero;
    long long somaPositivos = 0, somaNegativos = 0;
    int qtdPositivos = 0, qtdNegativos = 0;

    do {
        printf("Digite um numero inteiro (0 para encerrar): ");
        scanf("%d", &numero);

        if (numero > 0) {
            somaPositivos += numero;
            qtdPositivos++;
        } else if (numero < 0) {
            somaNegativos += numero;
            qtdNegativos++;
        }
    } while (numero != 0);

    printf("\nSoma dos positivos: %lld\n", somaPositivos);
    printf("Soma dos negativos: %lld\n", somaNegativos);
    printf("Quantidade de positivos: %d\n", qtdPositivos);
    printf("Quantidade de negativos: %d\n", qtdNegativos);
