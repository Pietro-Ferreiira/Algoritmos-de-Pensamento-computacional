* Questao 1 (Vamos Praticar): Condominio - consumo de agua.
 * Le o consumo mensal (m3) de 5 moradores. Para cada um informa se esta
 * dentro da media (ate 20 m3) ou acima. Ao final, mostra o consumo medio geral.
 */
#include <stdio.h>

#define MORADORES 5
#define LIMITE 20.0f

int main() {
    float consumo;
    float soma = 0;
    int i;

    for (i = 1; i <= MORADORES; i++) {
        printf("Consumo do morador %d (m3): ", i);
        scanf("%f", &consumo);

        if (consumo <= LIMITE) {
            printf("  Morador %d: dentro da media (ate %.0f m3).\n", i, LIMITE);
        } else {
            printf("  Morador %d: ACIMA da media (mais de %.0f m3).\n", i, LIMITE);
        }

        soma += consumo;
    }

    printf("\nConsumo medio geral: %.2f m3\n", soma / MORADORES);
    return 0;
}
* Questao 2 (Vamos Praticar): Cofrinho digital.
 * O usuario adiciona moedas de R$0,50, R$1,00 ou R$2,00 quantas vezes quiser.
 * Ao decidir parar, o programa mostra o total acumulado.
 *
 * O total eh guardado em CENTAVOS (int) para evitar erros de arredondamento
 * de numeros float.
 */
#include <stdio.h>

int main() {
    int opcao;
    int totalCentavos = 0;

    do {
        printf("\n--- Cofrinho Digital ---\n");
        printf("1 - Adicionar moeda de R$ 0,50\n");
        printf("2 - Adicionar moeda de R$ 1,00\n");
        printf("3 - Adicionar moeda de R$ 2,00\n");
        printf("0 - Parar e ver o total\n");
        printf("Escolha: ");
        scanf("%d", &opcao);

        switch (opcao) {
            case 1: totalCentavos += 50;  break;
            case 2: totalCentavos += 100; break;
            case 3: totalCentavos += 200; break;
            case 0: break;
            default: printf("Opcao invalida!\n");
        }

        if (opcao >= 1 && opcao <= 3) {
            printf("Saldo atual: R$ %d,%02d\n", totalCentavos / 100, totalCentavos % 100);
        }
    } while (opcao != 0);

    printf("\nTotal acumulado no cofrinho: R$ %d,%02d\n", totalCentavos / 100, totalCentavos % 100);
    return 0;
}
* Questao 3 (Vamos Praticar): Nota media do atendimento.
 * Le a nota (0 a 10) de 10 clientes e calcula a media geral.
 * Se a media for menor que 7, exibe uma mensagem de alerta.
 */
#include <stdio.h>

#define CLIENTES 10

int main() {
    float nota;
    float soma = 0;
    float media;
    int i;

    for (i = 1; i <= CLIENTES; i++) {
        do {
            printf("Nota do cliente %d (0 a 10): ", i);
            scanf("%f", &nota);
            if (nota < 0 || nota > 10) {
                printf("  Nota invalida! Digite um valor entre 0 e 10.\n");
            }
        } while (nota < 0 || nota > 10);

        soma += nota;
    }

    media = soma / CLIENTES;
    printf("\nMedia geral do atendimento: %.2f\n", media);

    if (media < 7) {
        printf("ALERTA: a media esta abaixo de 7! O atendimento precisa melhorar.\n");
    }

    return 0;
}
* Questao 4 (Vamos Praticar): Meta diaria de passos.
 * Le a quantidade de passos dados a cada hora. Para quando o total atingir ou
 * ultrapassar 10.000 passos e informa quantas horas foram necessarias.
 */
#include <stdio.h>

#define META 10000

int main() {
    int passos;
    int total = 0;
    int horas = 0;

    while (total < META) {
        horas++;
        do {
            printf("Passos dados na hora %d: ", horas);
            scanf("%d", &passos);
            if (passos < 0) {
                printf("  Valor invalido! Digite um numero maior ou igual a 0.\n");
            }
        } while (passos < 0);

        total += passos;
        printf("  Total acumulado: %d passos\n", total);
    }

    printf("\nMeta de %d passos atingida em %d hora(s)! Total: %d passos.\n", META, horas, total);
    return 0;
}
