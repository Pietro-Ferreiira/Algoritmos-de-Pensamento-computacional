}
* Lista - Questao 7: Ler um inteiro entre 0 e 10 (repetindo a leitura ate o
 * valor ser valido) e apresentar o fatorial.
 * Exemplo: Entrada: 5  ->  Saida: 5! = 120
 */
#include <stdio.h>

int main() {
    int numero, i;
    int fatorial = 1;

    do {
        printf("Digite um numero inteiro entre 0 e 10: ");
        scanf("%d", &numero);
        if (numero < 0 || numero > 10) {
            printf("  Valor fora do intervalo! Tente novamente.\n");
        }
    } while (numero < 0 || numero > 10);

    for (i = 2; i <= numero; i++) {   /* 0! = 1! = 1 */
        fatorial *= i;
    }

    printf("%d! = %d\n", numero, fatorial);
    return 0;
}
* Lista - Questao 8: Jogo do numero secreto (1 a 100).
 * A cada palpite informa se o numero secreto eh maior, menor ou se acertou.
 * Limite de 10 tentativas; ao final informa o numero de tentativas e, se nao
 * acertou, revela o numero secreto.
 */
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define MAX_TENTATIVAS 10

int main() {
    int secreto, palpite;
    int tentativas = 0;
    int acertou = 0;

    srand((unsigned) time(NULL));
    secreto = rand() % 100 + 1;   /* numero entre 1 e 100 */

    printf("=== JOGO DO NUMERO SECRETO ===\n");
    printf("Adivinhe o numero entre 1 e 100. Voce tem %d tentativas.\n\n", MAX_TENTATIVAS);

    while (tentativas < MAX_TENTATIVAS && !acertou) {
        printf("Tentativa %d de %d - Seu palpite: ", tentativas + 1, MAX_TENTATIVAS);
        scanf("%d", &palpite);
        tentativas++;

        if (palpite < secreto) {
            printf("O numero secreto eh maior\n");
        } else if (palpite > secreto) {
            printf("O numero secreto eh menor\n");
        } else {
            printf("Parabens! Voce acertou!\n");
            acertou = 1;
        }
    }

    printf("\nTentativas realizadas: %d\n", tentativas);
    if (!acertou) {
        printf("Que pena! Suas tentativas acabaram. O numero secreto era %d.\n", secreto);
    }

    return 0;
}
